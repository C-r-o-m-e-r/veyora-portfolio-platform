@inject IProfileService ProfileService

<header class="sticky top-0 z-50 border-b border-zinc-800/80 bg-surface/80 backdrop-blur-md">
    <div class="section-container flex h-16 items-center justify-between gap-4">
        <a href="/" class="group flex shrink-0 items-center gap-2 font-mono text-sm text-zinc-100">
            <span class="text-accent">&gt;</span>
            <span class="transition-colors group-hover:text-accent">@_profile.Name.Split(' ').FirstOrDefault()</span>
            <span class="animate-pulse-glow text-accent">_</span>
        </a>

        <nav class="hidden items-center gap-8 md:flex" aria-label="Primary">
            @foreach (var link in _navLinks)
            {
                <a href="@link.Href"
                   class="font-mono text-xs uppercase tracking-widest text-zinc-400 transition-colors hover:text-accent">
                    @link.Label
                </a>
            }
        </nav>

        <div class="flex items-center gap-3">
            <a href="/#contact" class="btn-primary hidden text-xs sm:inline-flex">
                Let's Talk
            </a>

            <button type="button"
                    class="inline-flex rounded-lg border border-zinc-700 p-2 text-zinc-300 transition-colors hover:border-accent/40 hover:text-accent md:hidden"
                    aria-label="@(_mobileMenuOpen ? "Close menu" : "Open menu")"
                    aria-expanded="@_mobileMenuOpen"
                    aria-controls="mobile-nav"
                    @onclick="ToggleMobileMenu">
                @if (_mobileMenuOpen)
                {
                    <span class="text-lg leading-none">&times;</span>
                }
                else
                {
                    <span class="flex flex-col gap-1">
                        <span class="block h-0.5 w-5 bg-current"></span>
                        <span class="block h-0.5 w-5 bg-current"></span>
                        <span class="block h-0.5 w-5 bg-current"></span>
                    </span>
                }
            </button>
        </div>
    </div>

    @if (_mobileMenuOpen)
    {
        <nav id="mobile-nav"
             class="border-t border-zinc-800 bg-surface/95 px-4 py-4 md:hidden"
             aria-label="Mobile">
            <div class="flex flex-col gap-1">
                @foreach (var link in _navLinks)
                {
                    <a href="@link.Href"
                       class="rounded-lg px-3 py-2.5 font-mono text-sm uppercase tracking-widest text-zinc-300 transition-colors hover:bg-zinc-900 hover:text-accent"
                       @onclick="CloseMobileMenu">
                        @link.Label
                    </a>
                }
                <a href="/#contact"
                   class="btn-primary mt-2 text-center text-xs"
                   @onclick="CloseMobileMenu">
                    Let's Talk
                </a>
            </div>
        </nav>
    }
</header>

@code {
    private ProfileInfo _profile = default!;
    private bool _mobileMenuOpen;

    private readonly (string Label, string Href)[] _navLinks =
    [
        ("About", "/#about"),
        ("Projects", "/#projects"),
        ("Experience", "/#experience"),
        ("Contact", "/#contact")
    ];

    protected override void OnInitialized()
    {
        _profile = ProfileService.GetProfile();
    }

    private void ToggleMobileMenu()
    {
        _mobileMenuOpen = !_mobileMenuOpen;
    }

    private void CloseMobileMenu()
    {
        _mobileMenuOpen = false;
    }
}
