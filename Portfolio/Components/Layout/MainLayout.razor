@inherits LayoutComponentBase

<div class="relative min-h-screen bg-surface">
    <div class="pointer-events-none fixed inset-0 bg-grid-pattern bg-[size:4rem_4rem] opacity-40" aria-hidden="true"></div>
    <div class="pointer-events-none fixed inset-0 bg-gradient-to-b from-accent/5 via-transparent to-transparent" aria-hidden="true"></div>

    <div class="relative flex min-h-screen flex-col">
        <SiteHeader @rendermode="InteractiveServer" />
        <main class="flex-1">
            @Body
        </main>
        <SiteFooter />
    </div>
</div>

<div id="blazor-error-ui" class="fixed bottom-0 left-0 right-0 z-[100] hidden border-t border-red-900 bg-red-950 px-4 py-3 text-sm text-red-100">
    An unhandled error has occurred.
    <a href="" class="ml-2 underline">Reload</a>
    <button type="button" class="dismiss ml-4 text-red-300">Dismiss</button>
</div>
