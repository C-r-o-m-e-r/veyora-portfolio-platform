@inject IContactService ContactService

@if (_messages.Count == 0)
{
    <p class="text-sm text-zinc-500">No contact messages yet.</p>
}
else
{
    <div class="space-y-4">
        @foreach (var message in _messages)
        {
            <article class="rounded-lg border border-zinc-800 bg-zinc-950/60 p-4">
                <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
                    <div>
                        <p class="font-semibold text-white">@message.Name</p>
                        <p class="font-mono text-xs text-zinc-400">@message.Email</p>
                    </div>
                    <div class="flex items-center gap-3">
                        <time class="font-mono text-xs text-zinc-500">
                            @message.CreatedAt.ToLocalTime().ToString("MMM d, yyyy · HH:mm")
                        </time>
                        <button type="button"
                                class="message-delete-btn"
                                aria-label="Delete message from @message.Name"
                                @onclick="() => DeleteMessageAsync(message.Id)">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916A2.25 2.25 0 0 0 18.16 2.25h-3.32a2.25 2.25 0 0 0-2.244 2.077V5.79m0 0H5.375" />
                            </svg>
                        </button>
                    </div>
                </div>
                <p class="mt-3 text-sm leading-relaxed text-zinc-300">@message.Message</p>
            </article>
        }
    </div>
}

@code {
    private List<ContactMessage> _messages = [];

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    public async Task ReloadAsync()
    {
        _messages = (await ContactService.GetAllAsync()).ToList();
    }

    private async Task DeleteMessageAsync(int id)
    {
        await ContactService.DeleteAsync(id);
        _messages.RemoveAll(m => m.Id == id);
    }
}
