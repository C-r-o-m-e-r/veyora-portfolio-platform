@inject ITimelineService TimelineService

<section id="experience" class="section-container py-20 sm:py-28">
    <div class="max-w-2xl">
        <p class="section-heading">Experience</p>
        <h2 class="section-title">Education &amp; milestones</h2>
    </div>

    <div class="relative mt-12">
        <div class="absolute left-[7px] top-2 bottom-2 w-px bg-zinc-800 sm:left-1/2 sm:-ml-px" aria-hidden="true"></div>

        <ol class="space-y-10">
            @foreach (var (entry, index) in _entries.Select((e, i) => (e, i)))
            {
                <li class="relative grid gap-4 sm:grid-cols-2 sm:gap-8 @(index % 2 == 0 ? "" : "sm:[&>div:first-child]:order-2")">
                    <div class="@(index % 2 == 0 ? "sm:text-right" : "")">
                        <time class="font-mono text-xs text-accent">@entry.Period</time>
                        <p class="mt-1 text-xs uppercase tracking-wider text-zinc-500">@entry.Type</p>
                    </div>

                    <div class="card relative sm:col-start-2 @(index % 2 == 0 ? "sm:col-start-2" : "sm:col-start-1 sm:row-start-1")">
                        <span class="absolute -left-[1.35rem] top-6 hidden h-3 w-3 rounded-full border-2 border-accent bg-surface sm:block @(index % 2 == 0 ? "sm:left-auto sm:-right-[1.85rem]" : "sm:-left-[1.85rem]")"></span>
                        <h3 class="font-semibold text-white">@entry.Title</h3>
                        <p class="mt-1 text-sm text-accent/80">@entry.Organization</p>
                        <p class="mt-3 text-sm leading-relaxed text-zinc-400">@entry.Description</p>
                    </div>
                </li>
            }
        </ol>
    </div>
</section>

@code {
    private IReadOnlyList<TimelineEntry> _entries = [];

    protected override void OnInitialized()
    {
        _entries = TimelineService.GetEntries();
    }
}
